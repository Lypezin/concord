    "test": "node --no-warnings=ExperimentalWarning --import tsx src/verify.ts"
  },
  "dependencies": {
    "@concord/shared": "*",
    "@fastify/cors": "^11.4.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.3.0",
    "fastify": "^5.12.0",
    "livekit-server-sdk": "^2.20.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.0"
  }
}
