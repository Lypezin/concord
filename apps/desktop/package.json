{
  "name": "@concord/desktop",
  "version": "0.2.0",
  "description": "Chat, voz e compartilhamento de tela privado entre amigos",
  "author": "Lypezin",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:electron-updater --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "dev:vite": "vite",
    "dev": "npm run build:electron && concurrently -k -n vite,electron -c green,blue \"vite --port 5173 --strictPort\" \"node scripts/wait-and-launch-electron.mjs\"",
    "build": "vite build && npm run build:electron",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "dependencies": {
    "@concord/shared": "*",
    "@sapphi-red/web-noise-suppressor": "^0.4.2",
    "electron-updater": "^6.8.11",
    "livekit-client": "^2.25.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.lypezin.concord",
    "productName": "Concord",
    "electronVersion": "45.4.1",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/icon.png"
    ],
    "asarUnpack": [
      "electron/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png",
      "artifactName": "Concord-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Concord"
    },
    "publish": {
      "provider": "github",
      "owner": "Lypezin",
      "repo": "concord",
      "releaseType": "release"
    }
  }
}
